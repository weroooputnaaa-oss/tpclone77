local function getTool(char, name)
    return backpack:FindFirstChild(name) or (char and char:FindFirstChild(name))
end

local function activateTool(tool)
    if CONFIG.USE_ACTIVATE_INSTEAD_OF_REMOTE then tool:Activate() return end
    local remote = tool:FindFirstChild(CONFIG.PREFER_REMOTE_NAME)
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer()
    elseif remote and remote:IsA("RemoteFunction") then
        pcall(remote.InvokeServer, remote)
    else
        tool:Activate()
    end
end

-- Quantum Cloner Remote
local TeleportRemote = nil
pcall(function()
    local Packages = SERVICES.ReplicatedStorage:FindFirstChild("Packages")
    local Net = Packages and Packages:FindFirstChild("Net")
    if Net then
        local NetCloneQC = Net:Clone()
        NetCloneQC.Parent = SERVICES.ReplicatedStorage
        local NetQC = require(NetCloneQC)
        local function GetRemoteQC(oldName, remoteType)
            local success, result = xpcall(function()
                local remoteName
                if remoteType == "FireServer" then
                    remoteName = NetQC:RemoteEvent(oldName)
                elseif remoteType == "InvokeServer" then
                    remoteName = NetQC:RemoteFunction(oldName)
                else return nil end
                return Packages.Net:FindFirstChild(tostring(remoteName))
            end, function() return nil end)
            if success then return result end
            return nil
        end
        TeleportRemote = GetRemoteQC("QuantumCloner/OnTeleport", "FireServer")
    end
end)

-- Modules
local function getModules()
    if STATE.syncModule and STATE.animalsModule then
        return STATE.syncModule, STATE.animalsModule
    end
    if _G.MorangueteHubShared and _G.MorangueteHubShared.getModules then
        STATE.syncModule, STATE.animalsModule = _G.MorangueteHubShared.getModules()
        return STATE.syncModule, STATE.animalsModule
    end
    local pkgs   = SERVICES.ReplicatedStorage:FindFirstChild("Packages")
    local shared = SERVICES.ReplicatedStorage:FindFirstChild("Shared")
    if pkgs   then local s = pkgs:FindFirstChild("Synchronizer");  if s then STATE.syncModule    = require(s) end end
    if shared then local a = shared:FindFirstChild("Animals");      if a then STATE.animalsModule = require(a) end end
    return STATE.syncModule, STATE.animalsModule
end

local function getChannel(name)
    local cache = STATE.channelCache
    if cache[name] and cache[name].Parent then return cache[name] end
    cache[name] = nil
    local sync = getModules()
    if not sync then return nil end
    local all = sync:GetAllChannels()
    local ch  = (all and all[name]) or sync:Create(nil, name, nil)
    if ch then cache[name] = ch end
    return ch
end

local function waitChannel(name, timeout)
    local ch = getChannel(name)
    if ch then return ch end
    local t = tick()
    repeat task.wait(0.1); ch = getChannel(name) until ch or tick() - t > (timeout or 10)
    return ch
end

-- Best Pet
local function parseGen(v)
    if type(v) == "number" then return v end
    if type(v) ~= "string" then return 0 end
    v = v:gsub("%s+", ""):upper()
    local n, s = v:match("([%d%.]+)([KMBTQ]?)")
    if not n then return 0 end
    local mult = ({ K=1e3, M=1e6, B=1e9, T=1e12, Q=1e15 })[s] or 1
    return (tonumber(n) or 0) * mult
end

local function getMyPlotName()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        local sign  = plot:FindFirstChild("PlotSign")
        local label = sign and sign:FindFirstChildWhichIsA("TextLabel", true)
        if label then
            local t = label.Text:lower()
            if t:find(player.DisplayName:lower()) or t:find(player.Name:lower()) then
                return plot.Name
            end
        end
    end
end

local function getPartPos(model)
    if not model then return nil end
    local p = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    return p and p.Position
end

local function findBestPetPosition()
    local sync, animals = getModules()
    if not sync or not animals then return nil end

    local steal = _G.MorangueteHubSelectedBrainrot
    if not steal and _G.MorangueteHubStealNearest then
        local t = _G.MorangueteHubStealNearest.currentBestPet
        if type(t) == "table" and t.PlotName and t.PodiumID then steal = t end
    end

    if steal and steal.PlotName and steal.PodiumID then
        local plots = workspace:FindFirstChild("Plots")
        local plot  = plots and plots:FindFirstChild(steal.PlotName)
        local ch    = plot and waitChannel(plot.Name)
        if ch then
            local entry = (ch:Get("AnimalList") or {})[steal.PodiumID]
            if type(entry) == "table" and not entry.Machine and entry.Index then
                return getPartPos(plot:FindFirstChild(entry.Index))
            end
        end
        return nil
    end

    local plots  = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    local myPlot = CONFIG.BEST_PET_SEARCH_OWN_PLOT_SKIP and getMyPlotName()
    local minGen = parseGen((_G.MorangueteHubConfig and _G.MorangueteHubConfig.Get
        and _G.MorangueteHubConfig.Get("esp.esp brainrots.min gen", nil)) or 0)
    local bestGen, bestPos = -1e9, nil

    for _, plot in ipairs(plots:GetChildren()) do
        if plot.Name == myPlot or not plot:GetAttribute("Tier") then continue end
        local ch = waitChannel(plot.Name)
        if not ch then continue end
        for _, entry in pairs(ch:Get("AnimalList") or {}) do
            if type(entry) == "table" and not entry.Machine and entry.Index then
                local gen = animals:GetGeneration(entry.Index, entry.Mutation, entry.Traits)
                if gen >= minGen and gen > bestGen then
                    local pos = getPartPos(plot:FindFirstChild(entry.Index))
                    if pos then bestGen, bestPos = gen, pos end
                end
            end
        end
    end
    return bestPos
end

-- Target Worker
local function startTargetWorker()
    if STATE.targetWorkerRunning then return end
    STATE.targetWorkerRunning = true
    task.spawn(function()
        while STATE.targetWorkerRunning do
            local pos = findBestPetPosition()
            if pos then
                STATE.targetCache.pos = pos
                STATE.targetCache.at  = tick()
            end
            task.wait(CONFIG.TARGET_REFRESH_INTERVAL)
        end
    end)
end

local function stopTargetWorker()
    STATE.targetWorkerRunning = false
end

-- Clone movement
local function moveCloneToTarget(cloneModel, targetPos)
    if not cloneModel or not targetPos then return end
    local hrp = cloneModel:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    pcall(function()
        cloneModel:PivotTo(
            CFrame.new(targetPos + Vector3.new(0, CONFIG.CLONE_TARGET_Y_OFFSET, 0))
            * cloneModel:GetPivot().Rotation
        )
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- Clone loop
local function startCloneLoop(cloneModel)
    if STATE.tpConn then
        STATE.tpConn:Disconnect()
        STATE.tpConn = nil
    end

    local hum = cloneModel:FindFirstChild("Humanoid")
    if hum then
        task.spawn(function()
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Ragdoll) end)
        end)
    end

    STATE.tpConn = SERVICES.RunService.Heartbeat:Connect(function()
        if not cloneModel or not cloneModel.Parent then
            STATE.tpConn:Disconnect()
            STATE.tpConn     = nil
            STATE.cloneModel = nil
            stopTargetWorker()
            return
        end
        local hr = cloneModel:FindFirstChild("HumanoidRootPart")
        if not hr then
            STATE.tpConn:Disconnect()
            STATE.tpConn     = nil
            STATE.cloneModel = nil
            stopTargetWorker()
            return
        end
        if STATE.teleportActive then
            local pos = STATE.targetCache.pos
            if pos then
                moveCloneToTarget(cloneModel, pos)
                if not STATE.clonerFired then
                    local dist = (hr.Position - pos).Magnitude
                    local isOwner = true
                    if isnetworkowner then
                        local ok, res = pcall(isnetworkowner, cloneModel.PrimaryPart or hr)
                        if ok then isOwner = res end
                    end
                    if dist < 15 and isOwner then
                        STATE.clonerFired = true
                        task.spawn(function()
                            local char = player.Character
                            if char then
                                local qc = getTool(char, "Quantum Cloner")
                                if qc then
                                    qc.Parent = char
                                    task.wait(CONFIG.CLONE_APPEAR_GRACE_PERIOD)
                                    pcall(function()
                                        if TeleportRemote then TeleportRemote:FireServer() end
                                    end)
                                end
                            end
                        end)
                    end
                end
            end
        else
            pcall(function()
                hr.AssemblyLinearVelocity  = Vector3.zero
                hr.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
end

-- Spam
local function startSpam()
    if STATE.spamRunning then return end
    STATE.spamRunning = true
    STATE.spamStart   = tick()

    STATE.spamConn = SERVICES.RunService.Heartbeat:Connect(function()
        if not STATE.spamRunning then
            if STATE.spamConn then STATE.spamConn:Disconnect(); STATE.spamConn = nil end
            return
        end
        local char = player.Character
        if not char then return end
        if STATE.cloneModel and STATE.cloneModel.Parent then
            STATE.spamRunning = false
            STATE.spamConn:Disconnect(); STATE.spamConn = nil
            return
        end
        if tick() - STATE.spamStart >= CONFIG.SPAM_TOTAL_DURATION then
            STATE.spamRunning = false
            STATE.spamConn:Disconnect(); STATE.spamConn = nil
            return
        end
        local bat = getTool(char, "Bat")
        if not bat then
            STATE.spamRunning = false
            STATE.spamConn:Disconnect(); STATE.spamConn = nil
            return
        end
        local qc = getTool(char, "Quantum Cloner")
        if qc then
            qc.Parent = char
            activateTool(qc)
            qc.Parent = backpack
        end
        for _ = 1, CONFIG.BAT_CYCLES_PER_FRAME do
            bat.Parent = char
            bat.Parent = backpack
        end
    end)
end

-- Detect clone
local expectedName = ("%s_Clone"):format(player.UserId)

local function listenForClone() end -- forward declare

local function attachClone(child)
    STATE.spamRunning = false
    STATE.clonerFired = false

    task.wait(CONFIG.CLONE_APPEAR_GRACE_PERIOD)

    local ok, cloneRoot = pcall(function()
        return child:WaitForChild("HumanoidRootPart", CONFIG.ROOT_WAIT_TIMEOUT)
    end)
    if not ok or not cloneRoot then warn("[ClonePanel] Clone has no HumanoidRootPart") return end

    if STATE.cloneConn then STATE.cloneConn:Disconnect(); STATE.cloneConn = nil end
    STATE.cloneModel = child

    local char = player.Character
    local bat  = getTool(char, "Bat")
    if bat then
        bat.Parent = char
        bat.Parent = child
        bat.Parent = player.Backpack
        bat.Parent = child
    end

    task.wait(0.05)

    if STATE.autoTpActive or STATE.onCloneReady then
        STATE.teleportActive = true
        if STATE.onCloneReady then STATE.onCloneReady() end
    end

    if STATE.teleportActive then startTargetWorker() end

    startCloneLoop(child)
end

listenForClone = function()
    if STATE.cloneConn then STATE.cloneConn:Disconnect() end
    STATE.cloneConn = workspace.ChildAdded:Connect(function(child)
        if child.Name ~= expectedName then return end
        task.spawn(attachClone, child)
    end)
end

listenForClone()

-- Auto TP loop
local function startAutoTpLoop()
    if STATE.autoTpLoopConn then return end
    STATE.autoTpLoopConn = SERVICES.RunService.Heartbeat:Connect(function()
        if not STATE.autoTpActive then
            STATE.autoTpLoopConn:Disconnect()
            STATE.autoTpLoopConn = nil
            return
        end
        if (not STATE.cloneModel or not STATE.cloneModel.Parent) and not STATE.spamRunning then
            STATE.cloneModel = nil
            listenForClone()
            task.delay(CONFIG.AUTOCLONE_RESPAWN_DELAY, function()
                if STATE.autoTpActive and not STATE.cloneModel and not STATE.spamRunning then
                    startSpam()
                end
            end)
            task.wait(CONFIG.AUTOCLONE_RESPAWN_DELAY + CONFIG.SPAM_TOTAL_DURATION + 1)
        end
    end)
end

-- One-time TP function (mirrors Auto TP exactly, no loop)
local function runTpOnce()
    STATE.teleportActive = false
    STATE.clonerFired    = false

    if not STATE.cloneModel or not STATE.cloneModel.Parent then
        -- No clone yet — spawn one, then activate TP once it's ready
        STATE.cloneModel = nil

        STATE.onCloneReady = function()
            STATE.teleportActive = true
            STATE.onCloneReady   = nil
        end

        listenForClone()
        startSpam()
    else
        -- Clone already exists — activate TP immediately, fire one instant move,
        -- then keep the loop running so it holds position
        STATE.teleportActive = true
        STATE.onCloneReady   = nil

        startTargetWorker()

        -- Kick off an immediate TP attempt without waiting for the first Heartbeat
        task.spawn(function()
            -- Give the target worker one tick to populate the cache if it's cold
            if not STATE.targetCache.pos then
                task.wait(CONFIG.TARGET_REFRESH_INTERVAL)
            end
            local pos = STATE.targetCache.pos
            if pos and STATE.cloneModel and STATE.cloneModel.Parent then
                moveCloneToTarget(STATE.cloneModel, pos)
            end
        end)

        startCloneLoop(STATE.cloneModel)
    end
end

