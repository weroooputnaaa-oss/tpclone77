        startAutoTpLoop()

        if not STATE.cloneModel or not STATE.cloneModel.Parent then
            STATE.cloneModel = nil
            listenForClone()
            startSpam()
            lblAutoTp.Text = "Auto TP: Spawning..."
        end
    else
        STATE.onCloneReady = nil
        STATE.teleportActive = false
        if STATE.autoTpLoopConn then
            STATE.autoTpLoopConn:Disconnect()
            STATE.autoTpLoopConn = nil
        end
        stopTargetWorker()
    end
end)

-- ─── TP Once button ───────────────────────────────────────────────────────────
btnTp.MouseButton1Click:Connect(function()
    lblTp.Text = "TP Once: Running..."
    setDot(dotTp, true)
    btnTp.BackgroundColor3 = COLOR_TP_ON

    runTpOnce()

    task.delay(CONFIG.SPAM_TOTAL_DURATION + 1.5, function()
        lblTp.Text = "TP Once"
        setDot(dotTp, false)
        btnTp.BackgroundColor3 = COLOR_TP_OFF
    end)
end)

-- Apply loaded state
if STATE.autoTpActive then
    setDot(dotAutoTp, true)
    btnAutoTp.BackgroundColor3 = COLOR_AUTOTP_ON
    lblAutoTp.Text             = "Auto TP: Spawning..."

    STATE.onCloneReady = function()
        STATE.teleportActive = true
        lblAutoTp.Text = "Auto TP: ON"
    end

    startAutoTpLoop()
    if not STATE.cloneModel or not STATE.cloneModel.Parent then
        listenForClone()
        startSpam()
    end
end
